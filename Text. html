ฟังก์ชัน updateProgress() {
  const n = Object.values(mastered).filter(Boolean).length;
  progressFill.style.width = (n / HIRAGANA.length * 100) + '%';
  progressText.textContent = `${n} / ${HIRAGANA.length}`;
}

// โ”€o”€ คำแนะนำ & ข้าม โ”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€โ ”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€
hintBtn.addEventListener('click', () => {
  ถ้า (!currentChar || answered) ให้คืนค่ากลับ;
  const r = currentChar.r;
  setFeedback('hint', `๐Ÿ'ก เน€เธียนเธียกเอช”เน‰ังไทย "${r[0].toUpperCase()}" โ€” ${r.length} เธ•ฑ์ธันฑ์เธซซ`);
  setTimeout(() => { if (!answered) { feedback.className='feedback empty'; feedback.textContent=''; } }, 2500);
});

skipBtn.addEventListener('click', () => {
  ถ้า (ตอบแล้ว) ให้ส่งคืน;
  clearInterval(clockInterval); stopListening();
  ตอบแล้ว = จริง;
  weights[currentChar.h] = Math.min(10, weights[currentChar.h] + 1);
  setFeedback('timeout', `โ ญ เธ‰ เธียก โ€” เธียเธ• เธชเธ่เธ่ "${currentChar.r.toUpperCase()}"`);
  setTimeout(() => nextQuestion(), 1300);
});

// โ”€o”€ ตำนาน โ”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€ โ”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€o”€
ฟังก์ชัน buildLegend() {
  legendGrid.innerHTML = '';
  HIRAGANA.forEach(c => {
    const cell = document.createElement('div');
    cell.className = 'legend-cell';
    cell.innerHTML = `
      <div class="hira">${ch}</div>
      <div class="roma">${cr}</div>
      <div class="weight-bar"><div class="weight-fill" id="wb-${ch}" style="width:${wPct(ch)}%"></div></div>
    `;
    legendGrid.appendChild(cell);
  });
}

const wPct = h => Math.min(100, ((weights[h]-1)/9)*100);

ฟังก์ชัน updateLegendWeights() {
  HIRAGANA.forEach(c => { const el = $(`wb-${ch}`); if(el) el.style.width = wPct(ch)+'%'; });
}

legendToggle.addEventListener('click', () => {
  const open = legendGrid.classList.toggle('open');
  legendArrow.textContent = เปิด ? 'โ–ฒ' : 'โค–ผ';
  ถ้า (เปิด) สร้างคำอธิบาย();
});

